					39 01 00 00 00 00 04 FF 08 58 00
				];

				qcom,dsi-panel-date-switch-command = [
					39 01 00 00 00 00 04 FF 08 58 1D
				];

				qcom,mdss-dsi-lp1-command = [
					/*HSTV change to optimize AOD Flicker*/
					39 00 00 40 00 00 04 FF 08 58 0B
					15 00 00 40 00 00 02 86 10
					15 00 00 40 00 00 02 A0 70
					/* EL setting */
					39 00 00 40 00 00 04 FF 08 58 1F
					15 00 00 40 00 00 02 87 2F
					/*Remapping off*/
					39 00 00 40 00 00 04 FF 08 58 63
					15 00 00 40 00 00 02 A0 00
					/* AOD Mode ON Setting */
					39 00 00 40 00 00 04 FF 08 58 00
					05 00 00 40 00 00 01 39
					15 00 00 40 00 00 02 61 0D
					39 00 00 40 00 00 05 51 00 00 0C D4
					39 00 00 00 00 00 04 FF 08 58 00
				];
				qcom,mdss-dsi-nolp-command = [
					/* CMD Q start */
					39 00 00 40 00 00 04 FF 08 58 4F
					15 00 00 40 00 00 02 80 01
					15 00 00 40 00 00 02 81 02
					15 00 00 40 00 00 02 88 78
					/* remove black frame */
					39 00 00 40 00 00 04 FF 08 58 02
					15 00 00 40 00 00 02 88 C0
					/*HSTV change return to normal*/
					39 00 00 40 00 00 04 FF 08 58 0B
					15 00 00 40 00 00 02 86 00
					15 00 00 40 00 00 02 A0 00
					/* EL setting */
					39 00 00 40 00 00 04 FF 08 58 1F
					15 00 00 40 00 00 02 87 29
					/*Remapping on*/
					39 00 00 40 00 00 04 FF 08 58 63
					15 00 00 40 00 00 02 A0 01
					/* AOD OFF */
					39 00 00 40 00 00 04 FF 08 58 00
					15 00 00 40 00 00 02 38 00
					/* CMD Q done */
					39 00 00 40 00 00 04 FF 08 58 4F
					15 00 00 40 00 00 02 8B 78
					39 00 00 00 00 00 04 FF 08 58 00
				];
				qcom,mdss-dsi-aod-high-mode-command = [
